using System;

namespace Task2
{
    interface IValidator
    {
        bool Validate();
    }

    class EmailValidator : IValidator
    {
        public string Email;

        public EmailValidator(string email)
        {
            Email = email;
        }

        public bool Validate()
        {
            if (Email.Contains("@") && Email.Contains("."))
                return true;
            else
                return false;
        }
    }

    class PasswordValidator : IValidator
    {
        public string Password;

        public PasswordValidator(string password)
        {
            Password = password;
        }

        public bool Validate()
        {
            if (Password.Length >= 6)
                return true;
            else
                return false;
        }
    }

    class Program
    {
        static void Main()
        {
            EmailValidator email = new EmailValidator("123@mail.com");
            PasswordValidator password = new PasswordValidator("123456");

            Console.WriteLine("Email підходить: " + email.Validate());
            Console.WriteLine("Пароль підходить: " + password.Validate());
        }
    }
}
