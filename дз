using System;

namespace Task1
{
    interface Irc
    {
        void TurnOn();
        void TurnOff();
        void SetChannel(int channel);
    }

    class TvControl : Irc
    {
        public void TurnOn()
        {
            Console.WriteLine("Телевізор увімкнено");
        }

        public void TurnOff()
        {
            Console.WriteLine("Телевізор вимкнено");
        }

        public void SetChannel(int channel)
        {
            Console.WriteLine("Телевізор: канал " + channel);
        }
    }

    class RadioControl : Irc
    {
        public void TurnOn()
        {
            Console.WriteLine("Радіо увімкнено");
        }

        public void TurnOff()
        {
            Console.WriteLine("Радіо вимкнено");
        }

        public void SetChannel(int channel)
        {
            Console.WriteLine("Радіо: " + channel);
        }
    }

    class Program
    {
        static void Main()
        {
            Irc tv = new TvControl();
            tv.TurnOn();
            tv.SetChannel(5);
            tv.TurnOff();

            Console.WriteLine();

            Irc radio = new RadioControl();
            radio.TurnOn();
            radio.SetChannel(101);
            radio.TurnOff();
        }
    }
}
